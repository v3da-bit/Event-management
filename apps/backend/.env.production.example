# Set these in Render's environment dashboard; never commit real secrets.
NODE_ENV=production
NODE_VERSION=24
# Render supplies PORT. Do not run the local database/seed script on deployment.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/everafter?retryWrites=true&w=majority
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app
# Generated independently by the Render Blueprint.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional until Google Calendar is connected:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The browser must return to Vercel so the OAuth state cookie is available.
GOOGLE_REDIRECT_URI=https://YOUR-FRONTEND.vercel.app/api/google-calendar/callback
# Optional until image uploads are used:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
