# Vercel project root: apps/frontend
# Include files outside the root directory in Vercel's project settings.
# Server/build-time proxy destination: Render origin, no path or trailing slash.
API_PROXY_URL=https://YOUR-API.onrender.com
# Browser calls the Vercel origin; do NOT set this to the Render URL.
NEXT_PUBLIC_API_URL=/api
# Optional Google Maps browser key restricted to your frontend domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
